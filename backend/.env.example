# 复制为 .env 后填入真实值。.env 绝不进仓库。
# 注意：MAF 不会自动读 .env，程序启动时显式加载（见 app/main.py）。

# --- 基础 ---
ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://workbench:workbench@localhost:5432/workbench

# --- 会话 Cookie ---
# 生产必须换成长随机串，并把 COOKIE_SECURE 置 true（HTTPS 下）
SESSION_SECRET=dev-only-change-me
COOKIE_SECURE=false

# --- P0 引导管理员（P1 接入 users 表后移除）---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# --- 模型厂商（可留空：留空的条目自动停用，不会导致启动失败）---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 中转站密钥（对应 models 表里 credential_ref=relay 的条目）
RELAY_API_KEY=

# --- 可观测 ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# 生产必须保持 false：开启会把 prompt 与工具参数写进 span
OTEL_ENABLE_SENSITIVE_DATA=false
